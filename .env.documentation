# Dicionário das variáveis utilizadas pela POC.
# Este arquivo documenta os valores atuais; não contém segredos diferentes.

COMPOSE_PROJECT_NAME=Nome do projeto Docker Compose.
GENERIC_TIMEZONE=Fuso horário dos serviços e registros.

N8N_HOST=Endereço anunciado pelo n8n.
N8N_PORT=Porta publicada do n8n.
N8N_PROTOCOL=Protocolo do n8n; usar https com TLS institucional.
N8N_WEBHOOK_URL=URL base usada para webhooks.
N8N_WEBHOOK_PATH=Rota do workflow que recebe mensagens.

EVOLUTION_PORT=Porta publicada da Evolution API.
EVOLUTION_SERVER_URL=URL anunciada pela Evolution API.
EVOLUTION_API_KEY=Chave do serviço Evolution API; trocar por secret seguro.
WHATSAPP_CLIENT_NAME=Nome da instância WhatsApp da POC.
EVOLUTION_CONTAINER_NAME=Nome do contêiner da Evolution API.
N8N_CONTAINER_NAME=Nome do contêiner n8n.
EVOLUTION_WEBHOOK_URL=URL resolvível pela Evolution API para chamar o n8n.

POSTGRES_USER=Usuário do banco da Evolution API.
POSTGRES_PASSWORD=Senha do banco; trocar e armazenar em secret.
POSTGRES_DB=Banco usado pela Evolution API.

REDIS_PORT=Porta interna do Redis.
REDIS_DB=Banco lógico do Redis.
REDIS_PREFIX=Prefixo das chaves da Evolution API.

OLLAMA_BASE_URL=Endereço do Ollama acessível pelo contêiner n8n.
OLLAMA_API_URL=Endpoint de chat usado pelo workflow.
OLLAMA_TAGS_URL=Endpoint usado pela auditoria para listar modelos.
OLLAMA_MODEL=Modelo local atualmente utilizado.

TRE_AI_CHAT_URL=Endereço da interface web de chat do TRE-GO.
TRE_AI_CPU_API_URL=Endereço da API CPU para alta concorrência.
TRE_AI_GPU_API_URL=Endereço da API GPU para respostas rápidas e uso individual.
TRE_AI_NATIVE_SUFFIX=Sufixo das APIs nativas.
TRE_AI_OPENAI_SUFFIX=Sufixo das APIs compatíveis com OpenAI.
TRE_AI_CHAT_MODEL=Modelo padrão para chat geral e triagem rápida.
TRE_AI_EMBEDDINGS_MODEL=Modelo para embeddings e busca em documentos (RAG).
TRE_AI_CODE_MODEL=Modelo para programação e geração de código.
TRE_AI_REASONING_MODEL=Modelo para raciocínio e análise complexa.
TRE_AI_ALTERNATIVE_CHAT_MODEL=Modelo alternativo para chat geral.

MESSAGING_PROVIDER=Adaptador atual; Evolution API até a validação institucional.
OMNICENTRAL_BASE_URL=Manter até receber a URL oficial do TRE-GO.
OMNICENTRAL_API_KEY=Manter até receber a credencial oficial do TRE-GO.
OMNICENTRAL_AUTH_HEADER=Confirmar com a documentação da OmniCentral.
OMNICENTRAL_AUTH_SCHEME=Confirmar se a autenticação usa Bearer ou outro esquema.
OMNICENTRAL_WEBHOOK_URL=Manter até receber a rota aprovada.
OMNICENTRAL_VERIFY_TLS=Não desabilitar TLS em ambiente corporativo.
