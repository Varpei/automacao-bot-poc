# Modelo público. Copie para .env e substitua os valores antes de executar.
COMPOSE_PROJECT_NAME=tre-bot-poc
GENERIC_TIMEZONE=America/Sao_Paulo
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_WEBHOOK_PATH=receber-whatsapp
EVOLUTION_PORT=8080
EVOLUTION_SERVER_URL=http://localhost:8080
EVOLUTION_API_KEY=SUBSTITUA_POR_CHAVE_SEGURA
WHATSAPP_CLIENT_NAME=GENERIC_POC
EVOLUTION_CONTAINER_NAME=app_evolution_api
N8N_CONTAINER_NAME=app_n8n
EVOLUTION_WEBHOOK_URL=http://evolution-api:8080/webhook/receber-whatsapp
POSTGRES_USER=app_user
POSTGRES_PASSWORD=SUBSTITUA_POR_SENHA_SEGURA
POSTGRES_DB=evolution
REDIS_PORT=6379
REDIS_DB=6
REDIS_PREFIX=evolution
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_API_URL=http://host.docker.internal:11434/api/chat
OLLAMA_TAGS_URL=http://localhost:11434/api/tags
OLLAMA_MODEL=llama3:latest
TRE_AI_CHAT_URL=https://chat.example.internal
TRE_AI_CPU_API_URL=https://api.example.internal
TRE_AI_GPU_API_URL=https://api-gpu.example.internal
TRE_AI_NATIVE_SUFFIX=/api/
TRE_AI_OPENAI_SUFFIX=/v1/
TRE_AI_CHAT_MODEL=modelo-de-chat-aprovado
TRE_AI_EMBEDDINGS_MODEL=modelo-de-embeddings-aprovado
TRE_AI_CODE_MODEL=modelo-de-codigo-aprovado
TRE_AI_REASONING_MODEL=modelo-de-raciocinio-aprovado
TRE_AI_ALTERNATIVE_CHAT_MODEL=modelo-alternativo-aprovado
MESSAGING_PROVIDER=evolution-api
OMNICENTRAL_BASE_URL=AINDA_NAO_INFORMADO
OMNICENTRAL_API_KEY=AINDA_NAO_INFORMADO
OMNICENTRAL_AUTH_HEADER=Authorization
OMNICENTRAL_AUTH_SCHEME=Bearer
OMNICENTRAL_WEBHOOK_URL=AINDA_NAO_INFORMADO
OMNICENTRAL_VERIFY_TLS=true
