      "typeVersion": 3,
      "position": [300, 300],
      "id": "e7b79714-50da-4978-9d30-e6ea63d82826",
      "notes": "Envia a mensagem ao endpoint de IA configurado no ambiente e aplica o prompt do projeto."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.EVOLUTION_SERVER_URL_INTERNAL }}/message/sendText/{{ $env.WHATSAPP_CLIENT_NAME }}",
